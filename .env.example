# ==============================================
# 옷장난감 (closetnangam) 로컬 개발 환경 설정
# ==============================================
# 이 파일을 복사해서 .env 로 이름 변경 후
# 실제 값을 채워주세요.
# .env 파일은 절대 Git에 커밋하지 마세요.　(.gitignore에 추가되어있음)
# ==============================================

# OAuth2 - 카카오 개발자 센터 (https://developers.kakao.com)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OAuth2 - 구글 클라우드 콘솔 (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 - 네이버 개발자 센터 (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# JWT - 32자 이상 임의 문자열로 설정
JWT_SECRET=

# Gemini - Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 선택: 무료 할당량 소진 시 순서대로 사용할 예비 키
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# 기상청 API - 공공데이터포털 (https://www.data.go.kr)
WEATHER_API_KEY=
# 선택: 기본 URL 변경 시에만 설정 (미설정 시 application.yml 기본값 사용)
WEATHER_API_URL=

# DB - docker-compose 기본값 (변경 시 docker-compose.yml도 함께 수정)
DB_USERNAME=root
DB_PASSWORD=local1234

# AWS (운영 배포 시 deploy/env.prod.example 참고)
AWS_REGION=ap-northeast-2
STORAGE_BACKEND=local
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# DB migration (기본 비활성 — 활성화 시 db/migration SQL 파일 유지 필요)
FLYWAY_ENABLED=false

# 운영(EC2) 환경 변수는 deploy/env.prod.example 참고