# ==============================================
# 옷장난감 BE 운영(EC2) 환경 변수
# ==============================================
# deploy/.env 로 복사 후 EC2에만 보관하세요.
# application-prod.yml.example → application-prod.yml 복사도 필요합니다.
# ==============================================

SPRING_PROFILES_ACTIVE=prod

# 공개 URL (HTTPS 권장)
APP_BASE_URL=
FE_BASE_URL=
CORS_ALLOWED_ORIGINS=

# RDS MySQL
RDS_HOST=
RDS_PORT=3306
RDS_DATABASE=closetnangamdb
DB_USERNAME=
DB_PASSWORD=

# Redis (docker-compose.prod.yml 사용 시 REDIS_HOST=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AWS S3 (img_url 저장)
AWS_REGION=ap-northeast-2
STORAGE_BACKEND=s3
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# OAuth2
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# JWT (32자 이상)
JWT_SECRET=

# External APIs
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
WEATHER_API_KEY=

# 운영 옵션
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=false
SWAGGER_ENABLED=false
STORAGE_LOCAL_BASE_PATH=/app/uploads
