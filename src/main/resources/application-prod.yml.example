# 운영(prod) 프로필 템플릿
# EC2에서 application-prod.yml 로 복사한 뒤 환경 변수(.env)와 함께 사용합니다.
# 실제 application-prod.yml 은 .gitignore 대상입니다.

spring:
  datasource:
    url: jdbc:mysql://${RDS_HOST}:${RDS_PORT:3306}/${RDS_DATABASE:closetnangamdb}?useSSL=true&requireSSL=true&serverTimezone=Asia/Seoul
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}

  jpa:
    hibernate:
      ddl-auto: ${JPA_DDL_AUTO:validate}
    show-sql: false

  flyway:
    enabled: ${FLYWAY_ENABLED:false}

  security:
    oauth2:
      client:
        registration:
          kakao:
            client-id: ${KAKAO_CLIENT_ID}
            client-secret: ${KAKAO_CLIENT_SECRET}
            redirect-uri: ${APP_BASE_URL}/login/oauth2/code/kakao
            authorization-grant-type: authorization_code
            scope: account_email
          google:
            client-id: ${GOOGLE_CLIENT_ID}
            client-secret: ${GOOGLE_CLIENT_SECRET}
            redirect-uri: ${APP_BASE_URL}/login/oauth2/code/google
            scope: profile, email
          naver:
            client-id: ${NAVER_CLIENT_ID}
            client-secret: ${NAVER_CLIENT_SECRET}
            redirect-uri: ${APP_BASE_URL}/login/oauth2/code/naver
            authorization-grant-type: authorization_code
            scope: name, email
        provider:
          naver:
            authorization-uri: https://nid.naver.com/oauth2.0/authorize
            token-uri: https://nid.naver.com/oauth2.0/token
            user-info-uri: https://openapi.naver.com/v1/nid/me
            user-name-attribute: response
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id

cloud:
  aws:
    region:
      static: ${AWS_REGION:ap-northeast-2}
    stack:
      auto: false

jwt:
  secret: ${JWT_SECRET}

gemini:
  api-key: ${GEMINI_API_KEY}

weather:
  api:
    key: ${WEATHER_API_KEY}
    url: ${WEATHER_API_URL:https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0}

server:
  forward-headers-strategy: framework

management:
  endpoints:
    web:
      exposure:
        include: health
  endpoint:
    health:
      probes:
        enabled: true

springdoc:
  swagger-ui:
    enabled: ${SWAGGER_ENABLED:false}
  api-docs:
    enabled: ${SWAGGER_ENABLED:false}

app:
  api:
    base-url: ${APP_BASE_URL}
  oauth2:
    redirect-uri: ${FE_BASE_URL}
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:}
  storage:
    backend: ${STORAGE_BACKEND:s3}
    local:
      base-path: ${STORAGE_LOCAL_BASE_PATH:/app/uploads}
      base-url: ${APP_BASE_URL}/api/v1/images
    s3:
      bucket: ${S3_BUCKET:}
      public-base-url: ${S3_PUBLIC_BASE_URL:}
  recommendation:
    complementary:
      ai-classification-enabled: true
      batch:
        enabled: false
